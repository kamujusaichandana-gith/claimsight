generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PolicyType {
  AUTO
  HOME
  HEALTH
  TRAVEL
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         UserRole       @default(CUSTOMER)
  createdAt    DateTime       @default(now())
  policies     Policy[]
  claims       Claim[]
  comments     ClaimComment[]
  statusChanges ClaimStatusHistory[]

  @@index([role, createdAt])
}

model Policy {
  id            String       @id @default(cuid())
  policyNumber  String       @unique
  type          PolicyType
  coverageAmount Decimal     @db.Decimal(12, 2)
  premium       Decimal      @db.Decimal(10, 2)
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  status        PolicyStatus @default(ACTIVE)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  claims        Claim[]

  @@index([userId, status])
  @@index([status, endDate])
}

model Claim {
  id           String         @id @default(cuid())
  claimNumber  String         @unique
  policyId     String
  userId       String
  incidentDate DateTime       @db.Date
  incidentType String
  description  String         @db.Text
  amount       Decimal        @db.Decimal(12, 2)
  status       ClaimStatus    @default(SUBMITTED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  policy       Policy         @relation(fields: [policyId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  comments     ClaimComment[]
  documents    ClaimDocument[]
  statusHistory ClaimStatusHistory[]

  @@index([policyId, status])
  @@index([userId, status, createdAt])
  @@index([createdAt])
}

model ClaimComment {
  id        String   @id @default(cuid())
  claimId   String
  authorId  String
  message   String   @db.Text
  createdAt DateTime @default(now())
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
  @@index([authorId])
}

model ClaimDocument {
  id         String   @id @default(cuid())
  claimId    String
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, uploadedAt])
}

model ClaimStatusHistory {
  id          String      @id @default(cuid())
  claimId     String
  fromStatus  ClaimStatus?
  toStatus    ClaimStatus
  changedById String
  createdAt   DateTime    @default(now())
  claim       Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
}